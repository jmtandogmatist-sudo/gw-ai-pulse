<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.goldwind.gw-pulse.weekly</string>

	<key>ProgramArguments</key>
	<array>
		<string>/Users/sr_jm/gw_llm_ai_pulse/.venv/bin/python</string>
		<string>-m</string>
		<string>collector</string>
		<string>weekly-report</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/sr_jm/gw_llm_ai_pulse/01-采集器</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>AIR_KEYCHAIN_SERVICE</key>
		<string>gw-ai-pulse</string>
		<key>TZ</key>
		<string>Asia/Shanghai</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>

	<key>StartCalendarInterval</key>
