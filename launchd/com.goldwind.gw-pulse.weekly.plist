	<key>StandardOutPath</key>
	<string>/Users/sr_jm/gw_llm_ai_pulse/01-采集器/logs/launchd-weekly.out</string>
	<key>StandardErrorPath</key>
	<string>/Users/sr_jm/gw_llm_ai_pulse/01-采集器/logs/launchd-weekly.err</string>
</dict>
</plist>
